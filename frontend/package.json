{
  "name": "capataz-frontend",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 9000",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 9000",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "generate:openapi": "openapi-typescript ${API_BASE_URL:-http://localhost:8000/api/v1}/openapi.json -o src/api/openapi.generated.ts"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.13",
    "@quasar/vite-plugin": "^1.10.0",
    "@vueuse/core": "^14.4.0",
    "pinia": "^3.0.2",
    "quasar": "^2.18.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.8",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^3.1.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.11.2",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.2",
    "vitest": "^3.1.1",
    "vue-tsc": "^2.2.8"
  }
}
