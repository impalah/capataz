# Solo usadas por "make docker-build"/"make docker-run" (ver Makefile) — config en TIEMPO DE
# EJECUCIÓN del contenedor, no build args de Vite. "npm run dev"/"npm run build" ignoran estas
# variables por completo: leen frontend/public/config.js directamente. Ver
# docs/adr/007-runtime-frontend-config.es.md.
#
# Se sirve por el proxy Nginx hacia api:8000 en producción.
CAPATAZ_FRONTEND_API_BASE_URL=/api/v1
# true = modo dev_mock (sin login); úsalo para desarrollo y tests sin IdP real.
CAPATAZ_FRONTEND_USE_MSW=true
# Identidad sintética inicial en modo dev_mock, antes de tocar el selector de rol del menú.
CAPATAZ_FRONTEND_DEV_USER=ana.admin
# Login OIDC (Authorization Code + PKCE), solo si CAPATAZ_FRONTEND_USE_MSW=false. Issuer/client_id
# públicos del mismo proveedor que valida la API (CAPATAZ_OIDC_ISSUER/AUDIENCE), o del
# dominio Hosted UI de Cognito. Ver docs/09-authentik-oidc-setup.es.md.
CAPATAZ_FRONTEND_OIDC_ISSUER=
CAPATAZ_FRONTEND_OIDC_CLIENT_ID=
CAPATAZ_FRONTEND_OIDC_SCOPE=openid profile email groups

# --- Solo Makefile: registry de imágenes (target "docker-build") ---
# Sin definir, "make docker-build" falla con un mensaje explicando qué falta.
REGISTRY_URI=
REGISTRY_USER=
REGISTRY_PASSWORD=

# Plataformas objetivo del build multi-arch (docker buildx). Por defecto solo
# amd64: capataz-frontend no se despliega hoy en nodos arm64.
PLATFORMS=linux/amd64

# --- Solo Makefile: análisis SonarQube (targets "sonar"/"sonar-check") ---
SONAR_HOST_URL=
SONAR_TOKEN=

# Bundle de certificados que valida la CA interna, si SonarQube corre detrás de una CA propia.
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

