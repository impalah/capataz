# Copia este fichero a .env (git-ignorado) para configurar los targets del
# Makefile que no son necesarios en el día a día (build/push de imagen,
# bump-version, análisis SonarQube). El .env del stack (raíz del repo) sigue
# siendo el único que configura el runtime del worker.

# --- Registry de imágenes (target "build") ---
# Sin definir, "make build" falla con un mensaje explicando qué falta —
# hasta que el proyecto tenga un registry real no hace falta rellenar esto.
REGISTRY_URI=
REGISTRY_USER=
REGISTRY_PASSWORD=

# Plataformas objetivo del build multi-arch (docker buildx). Por defecto solo
# amd64: capataz-runner no se despliega hoy en nodos arm64. Añade linux/arm64
# si eso cambia.
PLATFORMS=linux/amd64

# --- Análisis SonarQube (targets "sonar"/"sonar-check") ---
SONAR_HOST_URL=
SONAR_TOKEN=

# Bundle de certificados que valida la CA interna, si SonarQube corre detrás
# de una CA propia. El almacén de certificados del sistema funciona sin tocar
# nada en la mayoría de Debian/Ubuntu.
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
