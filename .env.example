# Non-sensitive Capataz configuration. Keep credentials only in secrets/ files.
CAPATAZ_ENV=development
CAPATAZ_LOG_LEVEL=INFO
CAPATAZ_LOG_JSON=false
CAPATAZ_API_HOST=0.0.0.0
CAPATAZ_API_PORT=8000
CAPATAZ_FRONTEND_PORT=8090
CAPATAZ_CORS_ORIGINS=http://localhost:8090,http://localhost:9000
# Used only to bootstrap the postgres container itself (POSTGRES_DB/POSTGRES_USER below in
# docker-compose.yml). api/runner never read these — they get the full DSN, password included,
# from the secrets/database_url Docker secret (see README.md).
CAPATAZ_POSTGRES_DB=capataz
CAPATAZ_POSTGRES_USER=capataz
CAPATAZ_CELERY_QUEUE=automation
CAPATAZ_CELERY_CONCURRENCY=2
CAPATAZ_PORTAINER_URL=https://portainer.home.arpa
CAPATAZ_GRAFANA_URL=https://grafana.home.arpa
CAPATAZ_LOKI_URL=https://loki.home.arpa
CAPATAZ_PROMETHEUS_URL=https://prometheus.home.arpa
CAPATAZ_COGNITO_REGION=eu-west-1
CAPATAZ_COGNITO_USER_POOL_ID=
CAPATAZ_COGNITO_APP_CLIENT_ID=
CAPATAZ_OIDC_ISSUER=
CAPATAZ_OIDC_AUDIENCE=
CAPATAZ_OIDC_JWKS_URI=
CAPATAZ_OIDC_GROUPS_CLAIM=groups
CAPATAZ_AUTH_MODE=dev_mock
CAPATAZ_INITIAL_CATALOG_YAML_PATH=/app/catalog/services.example.yaml
CAPATAZ_HTTP_TIMEOUT_SECONDS=5
CAPATAZ_HEALTH_ALLOWED_HOST_SUFFIXES=.home.arpa
CAPATAZ_STATUS_CACHE_TTL_SECONDS=30
# Vacío = api/runner usan el bundle público de CAs de siempre (certifi). Solo rellénalo si
# Portainer/Grafana/Loki/Prometheus/tu IdP OIDC están detrás de una CA interna (no pública)
# de tu homelab: `make trust-ca` la descarga y genera certs/ca-bundle.pem; entonces pon aquí
# SSL_CERT_FILE=/run/ca-certs/ca-bundle.pem (la ruta DENTRO del contenedor, no la del host).
SSL_CERT_FILE=
# Config del frontend en TIEMPO DE EJECUCIÓN del contenedor, no de build — un `docker compose up
# -d --force-recreate frontend` (sin rebuild) basta tras cambiar cualquiera de estas. Se
# renderizan en config.js al arrancar el contenedor (frontend/nginx/40-render-runtime-config.sh);
# ver docs/adr/007-runtime-frontend-config.es.md.
CAPATAZ_FRONTEND_API_BASE_URL=/api/v1
# true = sin login: el frontend usa un usuario sintético con rol elegible en el propio menú
# (viewer/operator/admin) y llama a la API real vía CAPATAZ_AUTH_MODE=dev_mock de arriba (nunca
# mockea datos en el navegador). Ponlo a false para probar el login real (Authentik/Cognito).
CAPATAZ_FRONTEND_USE_MSW=true
# Identidad sintética inicial mostrada al cargar en modo dev_mock (CAPATAZ_FRONTEND_USE_MSW=true),
# antes de tocar el selector de rol del menú. Útil para pruebas deterministas (p. ej. e2e).
CAPATAZ_FRONTEND_DEV_USER=ana.admin
# Frontend OIDC login (Authorization Code + PKCE). Debe apuntar al mismo issuer/client
# público que CAPATAZ_OIDC_ISSUER (o al dominio Hosted UI de Cognito).
CAPATAZ_FRONTEND_OIDC_ISSUER=
CAPATAZ_FRONTEND_OIDC_CLIENT_ID=
CAPATAZ_FRONTEND_OIDC_SCOPE=openid profile email groups
